datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  passwordHash String
  role        String   // ADMIN | HR | MENTOR | MENTEE
  phone       String?
  department  String?
  designation String?
  joiningDate DateTime?
  mentorId    Int?
  mentor      User?    @relation("MentorMentees", fields: [mentorId], references: [id])
  mentees     User[]   @relation("MentorMentees")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tasksCreated   Task[]           @relation("TaskCreator")
  tasksAssigned  Task[]           @relation("TaskAssignee")
  attachments       Attachment[]
  activities        TaskActivity[]
  notifications     Notification[]
  conversationsAsA  Conversation[] @relation("ConvUserA")
  conversationsAsB  Conversation[] @relation("ConvUserB")
  chatMessages      ChatMessage[]
  meetingsOrganized Meeting[]      @relation("MeetingsOrganized")
  meetingsInvited   Meeting[]      @relation("MeetingsInvited")
}

model Task {
  id                  Int       @id @default(autoincrement())
  title               String
  description         String
  priority            String    // LOW | MEDIUM | HIGH
  dueDate             DateTime
  status              String    @default("TODO") // TODO | IN_PROGRESS | DONE
  createdById         Int
  createdBy           User      @relation("TaskCreator", fields: [createdById], references: [id])
  assigneeId          Int
  assignee            User      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  completionNote      String?
  completedAt         DateTime?
  batchId             String?
  hasWorkspace        Boolean   @default(false)
  workspaceTemplateId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  subtasks    Subtask[]
  attachments Attachment[]
  activities  TaskActivity[]
  reviews     Review[]
}

model Subtask {
  id     Int     @id @default(autoincrement())
  taskId Int
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title  String
  isDone Boolean @default(false)
  order  Int     @default(0)
}

model Attachment {
  id           Int      @id @default(autoincrement())
  taskId       Int
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  mimeType     String
  size         Int
  uploadedById Int
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  kind         String   // REFERENCE | SUBMISSION
  createdAt    DateTime @default(now())
}

model Review {
  id         Int      @id @default(autoincrement())
  taskId     Int
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  verdict    String   // PASS | FAIL
  summary    String
  issuesJson String   @default("[]")
  createdAt  DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String   @default("")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Conversation {
  id            Int       @id @default(autoincrement())
  userAId       Int
  userA         User      @relation("ConvUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId       Int
  userB         User      @relation("ConvUserB", fields: [userBId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime?
  messages      ChatMessage[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model ChatMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
}

model Meeting {
  id          Int      @id @default(autoincrement())
  organizerId Int
  organizer   User     @relation("MeetingsOrganized", fields: [organizerId], references: [id], onDelete: Cascade)
  inviteeId   Int
  invitee     User     @relation("MeetingsInvited", fields: [inviteeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  meetingLink String?
  startAt     DateTime
  endAt       DateTime
  status      String   @default("PENDING") // PENDING | ACCEPTED | DECLINED | CANCELLED

  @@index([organizerId, startAt])
  @@index([inviteeId, startAt])
  @@index([inviteeId, status])
}

model TaskActivity {
  id         Int      @id @default(autoincrement())
  taskId     Int
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  action     String
  fromStatus String?
  toStatus   String?
  createdAt  DateTime @default(now())
}
